# PostgreSQL 16 connection string — single source of truth for the DB layer
# (src/lib/db.ts) and every scripts/migrate-*.ts / scripts/seed-*.ts script.
# Format: postgresql://USER:PASSWORD@HOST:PORT/DBNAME
# The app assumes a database named `jbp_cms`. Create the role/database on the
# server to match before running `npm run db:setup`.
DATABASE_URL=postgresql://USER:PASSWORD@localhost:5432/jbp_cms

# CMS session signing secret — the HS256 key every admin session cookie is
# signed with. Generate with:  openssl rand -base64 48
#
# LAUNCH BLOCKER (Brief 135): production refuses to boot when this is unset, is
# shorter than 32 chars, starts with the dev prefix "jbp-", or contains a
# placeholder marker like "change-me" — see src/lib/env-guards.ts. Rotating it
# invalidates every existing session (everyone re-logs-in), which is exactly
# what you want at cutover.
CMS_SESSION_SECRET=

# Preview Basic Auth (src/middleware.ts). When BOTH are set, the entire public
# site is behind HTTP Basic Auth. That is right for staging and wrong for
# production — so production must leave BOTH BLANK, and the Brief 135 env guard
# fails a production boot when either is set. localhost is always exempt, so
# local QA tooling is unaffected either way.
PREVIEW_USER=
PREVIEW_PASS=
# Escape hatch, normally unset: set to the literal string "intentional" only if
# you deliberately want a production host gated behind Basic Auth (a pre-launch
# soft-launch box). It inverts the guard above to "must be set and strong", and
# means no crawler can index the site.
# PREVIEW_AUTH_IN_PRODUCTION=

# DEAD VARIABLE — do not set. Nothing in the app reads CMS_ADMIN_PASSWORD; admin
# passwords live bcrypt-hashed in the cms_users table (use
# scripts/reset-admin-password.ts). It is listed here only so its meaning is
# unambiguous: the Brief 135 env guard FAILS a production boot if it is present,
# because a dead shared credential in an env file is precisely what survives a
# secret rotation.
# CMS_ADMIN_PASSWORD=

# Email delivery for contact / booking forms (e.g. Resend, SendGrid, SES)
# RESEND_API_KEY is also used by the CMS invite/approval emails (Brief 119) —
# when unset, those emails are logged to the server console instead of sent.
EMAIL_FROM=noreply@jblantonplumbing.com
EMAIL_TO=info@jblantonplumbing.com
RESEND_API_KEY=

# Brief 119 — invite-based CMS user creation
# Who must approve every new CMS account (defaults to marketing@jblantonplumbing.com)
CMS_APPROVER_EMAIL=marketing@jblantonplumbing.com
# Public origin used to build the emailed approval/set-password links. If unset,
# links fall back to the origin the initiating request arrived on.
NEXT_PUBLIC_BASE_URL=

# Brief 127 — SEO
# Origin used for every <link rel="canonical"> and sitemap <loc>. Defaults to
# the production domain and should stay that way EVERYWHERE (staging included):
# staging must emit production canonicals, never its own hostname. Only set
# this if the production domain itself ever changes.
# CANONICAL_BASE_URL=https://jblantonplumbing.com

# SITE_ENV — used by the env guards (src/lib/env-guards.ts) to decide whether a
# missing secret is fatal at boot.
#
# NO LONGER the robots.txt gate. It used to be: unset/non-production served
# "Disallow: /". That de-indexed the live site during the 2026-08-11 incident
# (see the INCIDENT block below), so robots.txt is now decided by the request
# host, and SITE_ENV=production only ever ADDS permission. To force
# "Disallow: /" on a host, set ROBOTS_DISALLOW=1.
SITE_ENV=

# Brief 128 — Analytics & conversion tracking (GA4, Google Ads, Meta Pixel, Bing UET)
# These are public client-side IDs, read by src/lib/analytics.ts and injected by
# src/components/analytics/.
#
# SUPERSEDED 2026-08-11: a blank value is NO LONGER a no-op. Each ID now falls
# back to the live value baked into src/lib/analytics.ts, so the tags load even on
# a box whose env file was never populated. Setting a var here still overrides it;
# NEXT_PUBLIC_TRACKING_DISABLED=1 is the only way to switch the tags off.
#
# These are the same IDs the live WordPress site uses — reusing them is
# intentional and preserves GA4 history, Ads conversion actions, and Meta/Bing
# audiences.
#
# NOTE: NEXT_PUBLIC_* values are inlined at BUILD time. After changing one, the
# app must be rebuilt (`npm run build`) — a pm2 restart alone will not pick it
# up. The deploy workflow builds on the box, so setting these in the box's env
# file before deploying is sufficient.
#
# Production values:
#   NEXT_PUBLIC_GA4_ID=G-SQZLV0V58J
#   NEXT_PUBLIC_GOOGLE_ADS_ID=AW-661617195
#   NEXT_PUBLIC_META_PIXEL_ID=1674876326613103
#   NEXT_PUBLIC_BING_UET_ID=97007877
# ─── 2026-08-11 INCIDENT: tracking + robots defaults were INVERTED ───────────
# The old live site was compromised and the staging environment was promoted to
# serve jblantonplumbing.com. That box had none of the vars below, so all five
# tracking tags went dark on the live site AND robots.txt served "Disallow: /"
# — the live site telling every crawler to drop it. The safeguards were
# protecting an environment that no longer existed, at the real one's expense.
#
# So the defaults now FAIL OPEN, and opting out is explicit:
#   * The five tracking IDs apply automatically (values live in
#     src/lib/analytics.ts and src/lib/whatconverts.ts). Leaving the vars below
#     blank NO LONGER disables anything.
#   * robots.txt is crawlable for any host on the brand domain (apex, www.,
#     staging.). A stale non-production SITE_ENV can no longer de-index it.
#
# WHEN A NEW STAGING ENVIRONMENT IS BUILT, set BOTH of these on it and rebuild:
#   NEXT_PUBLIC_TRACKING_DISABLED=1   # no GA4/Ads/Meta/Bing/WhatConverts
#   ROBOTS_DISALLOW=1                 # serve Disallow: / regardless of host
# Without them, staging reports into the production analytics accounts, burns
# numbers out of the live WhatConverts pool, and is indexable.
NEXT_PUBLIC_TRACKING_DISABLED=
ROBOTS_DISALLOW=

NEXT_PUBLIC_GA4_ID=
NEXT_PUBLIC_GOOGLE_ADS_ID=
NEXT_PUBLIC_META_PIXEL_ID=
NEXT_PUBLIC_BING_UET_ID=

# WhatConverts call tracking / Dynamic Number Insertion (src/lib/whatconverts.ts)
# The snippet the live WordPress theme carried in <head> (jb-blanton/header.php)
# and that was never ported to Next.js — so from cutover until now NO phone
# number on the site was ever swapped and every call came back unattributed.
#
# SUPERSEDED 2026-08-11, same as the four IDs above: blank is NO LONGER "off".
# It falls back to the live profile 102905, baked into src/lib/whatconverts.ts.
# Use NEXT_PUBLIC_TRACKING_DISABLED=1 to switch call tracking off.
#
# A box pointed at this profile checks numbers out of the live dynamic number
# pool and files visitors against real campaigns — with a small pool, test traffic
# can leave REAL visitors seeing the untracked default number.
#
# Build-time inlining caveat still applies: set it in the box's env file BEFORE a
# deploy so the build picks it up; a pm2 restart alone will not.
#
# Live value (now the default):
#   NEXT_PUBLIC_WHATCONVERTS_PROFILE_ID=102905
NEXT_PUBLIC_WHATCONVERTS_PROFILE_ID=
# Optional override for the vendor's per-account tracking host. Leave blank to
# use the default baked into src/lib/whatconverts.ts. Set this ONLY if
# WhatConverts reissues the snippet with a different hostname.
# NEXT_PUBLIC_WHATCONVERTS_HOST=

# Brief 134 — CMS media uploads to S3 + CloudFront
# Uploads used to be written to public/uploads/cms/ on the app server. That
# directory is EPHEMERAL on cloud hosting: every redeploy wipes it and silently
# breaks any page referencing an uploaded image. With these set, the upload API
# puts bytes in S3 and stores the CloudFront URL in the media catalog instead.
#
# These are SERVER-ONLY. Never prefix any of them with NEXT_PUBLIC_ and never
# expose AWS credentials to the browser — uploads always go through the
# authenticated /api/cms/upload route, and the bucket has no public write access.
#
# If S3_UPLOAD_BUCKET or S3_UPLOAD_PUBLIC_BASE_URL is blank, the upload route
# falls back to writing local disk (the old behavior) and logs a loud warning on
# every upload. That fallback exists so an un-provisioned environment keeps
# working — it is NOT acceptable in production.
#
# LAUNCH BLOCKER: production must boot with the bucket + distribution
# provisioned and these vars set, or uploaded media is lost on every deploy.
#
# NOTE: S3_UPLOAD_PUBLIC_BASE_URL's hostname is injected into next.config.mjs
# images.remotePatterns at BUILD time. After changing it the app must be REBUILT
# (`npm run build`) — a pm2 restart alone will not pick it up.
#
# Bucket that holds CMS uploads (private; no public write, no public list).
S3_UPLOAD_BUCKET=
# Bucket region. Falls back to AWS_REGION if unset.
S3_UPLOAD_REGION=us-east-1
# Key prefix inside the bucket. Defaults to uploads/cms/ when blank.
S3_UPLOAD_PREFIX=uploads/cms/
# CloudFront origin that fronts the bucket, no trailing slash.
# e.g. https://d1234abcd.cloudfront.net
S3_UPLOAD_PUBLIC_BASE_URL=
# Optional S3 API endpoint override. LEAVE BLANK in production — the SDK derives
# the real AWS endpoint from the region. Set it only to point at an
# S3-compatible service or a local stub when testing the upload path without an
# AWS account. Implies path-style addressing.
# S3_UPLOAD_ENDPOINT=

# AWS credentials — used by BOTH the S3 uploader above and the SES email option.
# In production prefer an instance/task IAM role and leave the keys blank; the
# SDK's default provider chain picks the role up automatically. Set the keys only
# for local development. Required IAM: s3:PutObject (+ s3:HeadObject for the
# migration script's idempotency check) on arn:aws:s3:::<bucket>/<prefix>*
# AWS_REGION=us-east-1
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=

# Brief 135 — automated database backups (OPS-1)
# The CMS database is self-managed Postgres on the app box itself
# (DATABASE_URL → localhost:5432/jbp_cms), so there is no RDS snapshot or
# point-in-time recovery underneath it. scripts/backup-db.sh is the only thing
# that gets a copy of the data off this machine.
#
# LAUNCH BLOCKER: production must have the bucket created, these vars set, and
# the cron job installed — otherwise losing the box permanently loses all 812
# articles, 227 city pages, 9,738 city-service pages and every unpublished
# draft. There is no WordPress original to re-import CMS-authored edits from.
#
# Read by scripts/backup-db.sh and scripts/restore-db.sh only — never by the
# app. Credentials come from the instance IAM role (leave AWS_* blank); the role
# needs s3:PutObject on arn:aws:s3:::<bucket>/<prefix>/* and nothing else.
#
# Bucket that holds database dumps. MUST NOT be the S3_UPLOAD_BUCKET above:
# different lifecycle, different retention, and a bucket the app can write to is
# not where backups belong.
BACKUP_S3_BUCKET=
# Key prefix inside the bucket. Dumps land under <prefix>/daily/ every run and
# additionally under <prefix>/weekly/ on the weekly day; retention is an S3
# lifecycle rule per tier (14 days / 56 days).
BACKUP_S3_PREFIX=cms-backups
# Bucket region. Falls back to AWS_REGION, then us-east-1.
BACKUP_S3_REGION=us-east-1
# Where dumps are written on the box before upload. Must be writable by the user
# the cron job runs as.
BACKUP_LOCAL_DIR=/var/backups/jbp-cms
# How many local .sql.gz files to keep on the box (S3 is the real archive).
BACKUP_KEEP_LOCAL=7
# ISO day-of-week (1=Mon … 7=Sun) whose run is also copied to the weekly tier.
BACKUP_WEEKLY_DOW=7

# Google Reviews (optional — scrape or use Places API)
GOOGLE_PLACES_API_KEY=
GOOGLE_PLACE_ID=

# Brief 156 — Bathrooms landing page (/bathrooms) Google Tag Manager container
#
# DELIBERATELY BLANK. The /bathrooms route is a clone of the Bathrooms division's
# Webflow landing page and ships switched off: with this unset,
# src/components/bathrooms/BathroomsGtm.tsx renders NOTHING — no script tag, no
# <noscript> iframe, no dataLayer push.
#
# Marketing's decision (Brief 156 §7) is GTM only. The container ID is supplied
# at the Bathrooms PPC cutover; from then on the Bathrooms team adds GA4, Meta
# Pixel and call tracking through the GTM dashboard without touching this repo.
# The live Webflow page's IDs are recorded in the brief, not here.
#
# Format is validated: `GTM-` plus uppercase alphanumerics. Anything else is
# treated as unset.
#
# Build-time inlining caveat applies (NEXT_PUBLIC_*): set it in the box's env file
# BEFORE a deploy so the build picks it up; a pm2 restart alone will not.
#
# ⚠️ AT CUTOVER, check this against the site-wide tags. The root layout mounts
# SiteAnalytics on every non-admin route, so /bathrooms ALREADY fires the main
# site's GA4, Google Ads, Meta Pixel and Bing UET (live IDs by default since
# 2026-08-11 — see NEXT_PUBLIC_TRACKING_DISABLED above). Those are direct gtag.js
# tags, not a GTM container, so there is no container-on-container double-fire —
# but the page would report into the plumbing AND bathrooms accounts at once.
NEXT_PUBLIC_BATHROOMS_GTM_ID=
