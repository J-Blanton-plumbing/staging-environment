# PostgreSQL 16 connection string — single source of truth for the DB layer
# (src/lib/db.ts) and every scripts/migrate-*.ts / scripts/seed-*.ts script.
# Format: postgresql://USER:PASSWORD@HOST:PORT/DBNAME
# The app assumes a database named `jbp_cms`. Create the role/database on the
# server to match before running `npm run db:setup`.
DATABASE_URL=postgresql://USER:PASSWORD@localhost:5432/jbp_cms

# CMS session signing secret — set to a long random string in production
CMS_SESSION_SECRET=

# Email delivery for contact / booking forms (e.g. Resend, SendGrid, SES)
# RESEND_API_KEY is also used by the CMS invite/approval emails (Brief 119) —
# when unset, those emails are logged to the server console instead of sent.
EMAIL_FROM=noreply@jblantonplumbing.com
EMAIL_TO=info@jblantonplumbing.com
RESEND_API_KEY=

# Brief 119 — invite-based CMS user creation
# Who must approve every new CMS account (defaults to marketing@jblantonplumbing.com)
CMS_APPROVER_EMAIL=marketing@jblantonplumbing.com
# Public origin used to build the emailed approval/set-password links. If unset,
# links fall back to the origin the initiating request arrived on.
NEXT_PUBLIC_BASE_URL=

# Brief 127 — SEO
# Origin used for every <link rel="canonical"> and sitemap <loc>. Defaults to
# the production domain and should stay that way EVERYWHERE (staging included):
# staging must emit production canonicals, never its own hostname. Only set
# this if the production domain itself ever changes.
# CANONICAL_BASE_URL=https://jblantonplumbing.com

# robots.txt gate. ONLY the real production deployment sets this to
# "production" (serves Allow + sitemap). Unset/anything else = Disallow: /
# so staging and dev can never be indexed. LAUNCH BLOCKER: production must
# boot with SITE_ENV=production or the live site blocks all crawlers.
SITE_ENV=

# Brief 128 — Analytics & conversion tracking (GA4, Google Ads, Meta Pixel, Bing UET)
# These are public client-side IDs, read by src/lib/analytics.ts and injected by
# src/components/analytics/. A BLANK value is a hard no-op: that tag never loads,
# makes no network request, and fires no events. That is the safeguard that keeps
# staging/dev traffic out of the production analytics accounts — LEAVE THEM BLANK
# EVERYWHERE EXCEPT PRODUCTION.
#
# LAUNCH BLOCKER: production must boot with all four set to the values below, or
# GA4 reporting, Google Ads conversion optimization, and the Meta/Bing campaigns
# all go dark at cutover. These are the same IDs the live WordPress site uses —
# reusing them is intentional and preserves GA4 history, Ads conversion actions,
# and Meta/Bing audiences.
#
# NOTE: NEXT_PUBLIC_* values are inlined at BUILD time. After changing one, the
# app must be rebuilt (`npm run build`) — a pm2 restart alone will not pick it
# up. The deploy workflow builds on the box, so setting these in the box's env
# file before deploying is sufficient.
#
# Production values:
#   NEXT_PUBLIC_GA4_ID=G-SQZLV0V58J
#   NEXT_PUBLIC_GOOGLE_ADS_ID=AW-661617195
#   NEXT_PUBLIC_META_PIXEL_ID=1674876326613103
#   NEXT_PUBLIC_BING_UET_ID=97007877
NEXT_PUBLIC_GA4_ID=
NEXT_PUBLIC_GOOGLE_ADS_ID=
NEXT_PUBLIC_META_PIXEL_ID=
NEXT_PUBLIC_BING_UET_ID=

# Brief 134 — CMS media uploads to S3 + CloudFront
# Uploads used to be written to public/uploads/cms/ on the app server. That
# directory is EPHEMERAL on cloud hosting: every redeploy wipes it and silently
# breaks any page referencing an uploaded image. With these set, the upload API
# puts bytes in S3 and stores the CloudFront URL in the media catalog instead.
#
# These are SERVER-ONLY. Never prefix any of them with NEXT_PUBLIC_ and never
# expose AWS credentials to the browser — uploads always go through the
# authenticated /api/cms/upload route, and the bucket has no public write access.
#
# If S3_UPLOAD_BUCKET or S3_UPLOAD_PUBLIC_BASE_URL is blank, the upload route
# falls back to writing local disk (the old behavior) and logs a loud warning on
# every upload. That fallback exists so an un-provisioned environment keeps
# working — it is NOT acceptable in production.
#
# LAUNCH BLOCKER: production must boot with the bucket + distribution
# provisioned and these vars set, or uploaded media is lost on every deploy.
#
# NOTE: S3_UPLOAD_PUBLIC_BASE_URL's hostname is injected into next.config.mjs
# images.remotePatterns at BUILD time. After changing it the app must be REBUILT
# (`npm run build`) — a pm2 restart alone will not pick it up.
#
# Bucket that holds CMS uploads (private; no public write, no public list).
S3_UPLOAD_BUCKET=
# Bucket region. Falls back to AWS_REGION if unset.
S3_UPLOAD_REGION=us-east-1
# Key prefix inside the bucket. Defaults to uploads/cms/ when blank.
S3_UPLOAD_PREFIX=uploads/cms/
# CloudFront origin that fronts the bucket, no trailing slash.
# e.g. https://d1234abcd.cloudfront.net
S3_UPLOAD_PUBLIC_BASE_URL=
# Optional S3 API endpoint override. LEAVE BLANK in production — the SDK derives
# the real AWS endpoint from the region. Set it only to point at an
# S3-compatible service or a local stub when testing the upload path without an
# AWS account. Implies path-style addressing.
# S3_UPLOAD_ENDPOINT=

# AWS credentials — used by BOTH the S3 uploader above and the SES email option.
# In production prefer an instance/task IAM role and leave the keys blank; the
# SDK's default provider chain picks the role up automatically. Set the keys only
# for local development. Required IAM: s3:PutObject (+ s3:HeadObject for the
# migration script's idempotency check) on arn:aws:s3:::<bucket>/<prefix>*
# AWS_REGION=us-east-1
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=

# Google Reviews (optional — scrape or use Places API)
GOOGLE_PLACES_API_KEY=
GOOGLE_PLACE_ID=
