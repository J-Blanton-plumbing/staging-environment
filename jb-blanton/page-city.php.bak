// Related articles (3 most recent)
$articles = get_posts( [ 'post_type' => 'jb_article', 'post_status' => 'publish', 'numberposts' => 3 ] );

// FAQs for this city
$faqs = get_posts( [
	'post_type'      => 'jb_faq',
	'post_status'    => 'publish',
	'posts_per_page' => 6,
	'meta_query'     => [
		[ 'key' => '_jb_faq_city', 'value' => $geo, 'compare' => '=' ],
	],
] );
if ( empty( $faqs ) ) {
	// fallback: generic FAQs
	$faqs = get_posts( [
		'post_type'      => 'jb_faq',
		'post_status'    => 'publish',
		'posts_per_page' => 6,
		'meta_query'     => [
			[ 'key' => '_jb_faq_city', 'compare' => 'NOT EXISTS' ],
		],
	] );
}

// City name for URLs (slug)
$city_slug = strtolower( str_replace( [ ' ', '.', "'", '/' ], [ '-', '', '', '-' ], $geo ) );
