# dependencies
node_modules/

# Next.js build output
.next/
.next-build/
.next-prev/
# Isolated verification builds (NEXT_DIST_DIR=.next-<brief>) — see Brief 141's
# note on verifying against a fresh build rather than a stale `next start`.
# Without this catch-all every brief that needs one has to remember to add its
# own line, and a `git add -A` sweeps a ~200 MB build directory into the commit.
.next-*/
out/

# environment files
.env
.env.local
.env.*.local

# OS
.DS_Store
Thumbs.db

# Pre-migration DB backups (Brief 74 rule) — local safety snapshots, not source
scripts/backups/

# CMS media uploads (Brief 134). Bytes belong in S3 + CloudFront, never in git.
# Note the `/*` — ignoring the directory itself would stop git descending into
# it, and the .gitkeep negation below would never take effect. The directory is
# kept because the un-provisioned fallback path in
# src/app/api/cms/upload/route.ts still writes here.
# The 19 files committed before this rule were untracked and deleted by
# Brief 150 (Track D), after the Brief 134 S3 migration was confirmed serving
# them from CloudFront. Only .gitkeep remains tracked.
public/uploads/cms/*
!public/uploads/cms/.gitkeep
human qa/clone-whyjblanton-hero.png
human qa/clone-whyjblanton-mobile.png
human qa/live-whyjblanton-hero.png
